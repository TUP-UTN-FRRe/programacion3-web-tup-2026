@model IEnumerable<WebAppMvc.Models.Jedi>
@{
    ViewData["Title"] = "Jedis";
}

<h2 class="display-4">Jedis!</h2>


@{
    var suma = 1 + 2;
}

@if (suma > 2)
{
    <p>La suma es mayor a 2</p>
}
else
{
    <p>La suma es menor o igual a 2</p>
}

<p>La suma de 1 + 2 es: @suma</p>

<p>La suma de 2 + 3 es: @(2 + 3)</p>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>LightSaber Color</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.LightSaberColor</td>
            </tr>
        }
    </tbody>