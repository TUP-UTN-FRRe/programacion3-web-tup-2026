@using TUP.Mundial.Entidades
@using TUP.Mundial.Entidades.Filtros
@using TUP.Mundial.Negocio
@implements IDisposable

<h3>Partidos</h3>

<input type="text" 
       value="@textoABuscar"
       @oninput="OnTextoChanged"
       placeholder="Ingrese texto a buscar..." 
       class="form-control mb-3" />
 
@if (cargando)
{
    <div>Cargando...</div>
}

@if (partidos is not null)
{
<table class="table">
    <thead>
        <tr>
            <th>Partido</th>
            <th>Goles Local</th>
            <th>Goles Visitante</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var partido in partidos)
        {
            <tr>
                <td>
                    @partido.Local.Nombre vs @partido.Visitante.Nombre
                    <br />
                    <a href="/ticket/grupo/@(partido.Local.Nombre)-vs-@(partido.Visitante.Nombre)" class="btn btn-primary">Comprar tickets</a>

                </td>
                <td>0</td>
                <td>0</td>
            </tr>
        }
    </tbody>
</table>
}

@code {
    private string textoABuscar = string.Empty;
    private List<Partido> partidos = null;
    private bool cargando = false;
    private System.Threading.Timer? debounceTimer;

    protected override void OnInitialized()
    {
        Buscar();
    }

    private void OnTextoChanged(ChangeEventArgs e)
    {
        textoABuscar = e.Value?.ToString() ?? string.Empty;

        // Cancelar el timer anterior si existe
        debounceTimer?.Dispose();

        // Crear un nuevo timer que ejecutará la búsqueda después de 500ms
        debounceTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                Buscar();
                StateHasChanged();
            });
        }, null, 500, System.Threading.Timeout.Infinite);
    }

    private void Buscar()           
    {

        partidos = null;
        cargando = true;

        StateHasChanged();

        //Thread.Sleep(2000);
        var partidoNegocio = new PartidoNegocio();

        var filtro = new PartidoFiltro()
            {
                TextoABuscar = textoABuscar
            };

        partidos = partidoNegocio.ObtenerListado(filtro);

        cargando = false;
    }

    public void Dispose()
    {
        debounceTimer?.Dispose();
    }

}
